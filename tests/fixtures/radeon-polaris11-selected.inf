;
; General installation section
;

[ati2mtag_Proxy_DS]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %13%\atikmpag.sys
[ati2mtag_KMD_DS]
AddReg = ati2mtag_ServiceSettings
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %13%\atikmdag.sys
[ati2mtag_ServiceSettings]
HKR,, PowerXpressLoad, %REG_DWORD%, 0xFFFFFFFF
[ati2mtag_Polaris11DS.Services]
AddService = amdkmdap, 0x00000002, ati2mtag_Proxy_DS, R300_EventLog_Inst
